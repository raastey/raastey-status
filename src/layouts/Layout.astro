---
import { basePath } from "../lib/paths";
import { heroClass } from "../lib/status";
import type { OverallStatus } from "../lib/status";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "history" | "releases";
  heroStatus?: OverallStatus;
  heroTitle?: string;
  heroSubtitle?: string;
}

const {
  title,
  description = "System status and release notes for roono.",
  current = "home",
  heroStatus,
  heroTitle,
  heroSubtitle,
} = Astro.props;

const fullTitle = current === "home" ? "roono status" : `${title} · roono status`;
const home = basePath();
const history = basePath("history/");
const releases = basePath("releases/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href={home}>
          <span class="brand__mark" aria-hidden="true">r</span>
          <span>roono status</span>
        </a>
        <nav class="topnav" aria-label="Status sections">
          <a href={home} aria-current={current === "home" ? "page" : undefined}>Status</a>
          <a href={history} aria-current={current === "history" ? "page" : undefined}>Incidents</a>
          <a href={releases} aria-current={current === "releases" ? "page" : undefined}>Releases</a>
        </nav>
      </div>
    </header>

    {
      heroStatus && heroTitle && (
        <section class={`hero hero--${heroClass(heroStatus)}`} aria-live="polite">
          <div class="hero__inner">
            <h1>{heroTitle}</h1>
            {heroSubtitle && <p>{heroSubtitle}</p>}
          </div>
        </section>
      )
    }

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <a href="https://roono.app">roono.app</a>
      <a href="https://writer.roono.app">Writer</a>
      <a href="https://jr.roono.app">roono-jr</a>
      <a href="https://github.com/raastey/roono-status">Source</a>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

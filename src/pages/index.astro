---
import Layout from "../layouts/Layout.astro";
import UptimeBar from "../components/UptimeBar.astro";
import { basePath } from "../lib/paths";
import {
  components,
  formatUpdatedAt,
  overallHeadline,
  overallStatus,
  statusLabel,
  statusUpdatedAt,
} from "../lib/status";

const history = basePath("history/");
const releases = basePath("releases/");
---

<Layout
  title="Current status"
  current="home"
  heroStatus={overallStatus}
  heroTitle={overallHeadline(overallStatus)}
  heroSubtitle={`Last updated ${formatUpdatedAt(statusUpdatedAt)} · Updated manually until automated monitoring ships.`}
>
  <section class="section-head">
    <h2>Current status by service</h2>
    <a href={history}>Incident history</a>
  </section>

  <ul class="components">
    {
      components.map((c) => (
        <li class="component">
          <header class="component__head">
            <div>
              <h3 class="component__name">
                {c.url ? <a href={c.url}>{c.name}</a> : c.name}
              </h3>
              <p class="component__desc">{c.description}</p>
            </div>
            <span class={`status-label status-label--${c.status}`}>
              {statusLabel(c.status)}
            </span>
          </header>
          <p class="uptime-caption">Uptime over the past 90 days</p>
          <UptimeBar status={c.status} />
        </li>
      ))
    }
  </ul>

  <aside class="about-blurb">
    <p>
      This page reports the health of roono's writer app, API, marketing site, roono-jr, and supporting services.
      Release narrative lives on <a href={releases}>release notes</a>.
      Past incidents on <a href={history}>incident history</a>.
    </p>
  </aside>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { basePath } from "../lib/paths";
import { releases } from "../lib/status";

const home = basePath();
---

<Layout
  title="Release notes"
  description="Writer-readable release notes for roono."
  current="releases"
>
  <h1 class="page-title">Release notes</h1>
  <p class="lead">
    What shipped, in writer-readable English. Technical detail lives in the-ways CHANGELOG.
    <a href={home}>Back to current status</a>.
  </p>

  <div class="release-list">
    {
      releases.map((r) => (
        <article class="release">
          <h3>
            v{r.version} — <em>{r.title}</em>
          </h3>
          <p class="meta">
            {r.date}
            {r.linearId ? ` · ${r.linearId}` : ""}
          </p>
          <p>{r.summary}</p>
          {r.sections?.map((section) => (
            <section>
              {section.heading && <h4>{section.heading}</h4>}
              {section.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </section>
          ))}
        </article>
      ))
    }
  </div>
</Layout>

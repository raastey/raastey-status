---
import Layout from "../layouts/Layout.astro";
import { basePath } from "../lib/paths";
import { incidents } from "../lib/status";

const home = basePath();
---

<Layout
  title="Incident history"
  description="Past incidents and maintenance windows for roono."
  current="history"
>
  <h1 class="page-title">Incident history</h1>
  <p class="lead">
    Past incidents and scheduled maintenance. When something affects writers, we post updates here.
    <a href={home}>Back to current status</a>.
  </p>

  {
    incidents.length === 0 ? (
      <div class="empty-state">
        <strong>No incidents reported</strong>
        <p>All systems have been running without a published incident.</p>
      </div>
    ) : (
      incidents.map((inc) => (
        <article class="incident-card">
          <h3>{inc.title}</h3>
          <p class="meta">
            {inc.impact} impact · {inc.status} ·{" "}
            {new Date(inc.createdAt).toLocaleDateString("en-GB")}
            {inc.resolvedAt
              ? ` → resolved ${new Date(inc.resolvedAt).toLocaleDateString("en-GB")}`
              : ""}
          </p>
          <ul>
            {inc.updates.map((u) => (
              <li>
                <time datetime={u.at}>{new Date(u.at).toUTCString()}</time> — {u.body}
              </li>
            ))}
          </ul>
        </article>
      ))
    )
  }
</Layout>
